{
  "name": "pdf-n-up",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --import tsx --import ./test/register-css.js --test test/*.test.js",
    "lint": "biome lint .",
    "lint:css": "stylelint \"{css,src}/**/*.css\"",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm typecheck && pnpm test && pnpm biome:check && pnpm lint:css && pnpm build",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "biome:check": "biome check ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "fflate": "0.8.2",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "^26.1.0",
    "stylelint": "17.14.1",
    "stylelint-config-standard": "40.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.1"
  }
}
